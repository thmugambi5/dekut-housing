rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    // Admins collection
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Landlords collection
    match /landlords/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());
      allow write: if request.auth != null && (isOwner(uid) || isAdmin());
    }
    
    // Users collection
    match /users/{uid} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());
      allow create: if request.auth != null && isOwner(uid);
      allow update: if request.auth != null && isOwner(uid);
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Pending Properties collection
    match /pendingProperties/{propertyId} {
      allow read: if request.auth != null && (isAdmin() || request.resource.data.landlordUid == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || (request.resource.data.landlordUid == request.auth.uid && request.resource.data.approved == false));
      allow update: if request.auth != null && (isAdmin() || (resource.data.landlordUid == request.auth.uid && resource.data.approved != true && request.resource.data.landlordUid == request.auth.uid && request.resource.data.approved == false));
      allow delete: if request.auth != null && (isAdmin() || (resource.data.landlordUid == request.auth.uid && !request.resource.exists()));
    }
    
    // Properties collection (approved)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (isAdmin() || (resource.data.landlordUid == request.auth.uid && request.resource.data.landlordUid == request.auth.uid && resource.data.approved == true));
      allow delete: if request.auth != null && isAdmin();
    }
    
    // Rejected Properties collection
    match /rejectedProperties/{propertyId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.landlordUid == request.auth.uid);
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && (isAdmin() || (resource.data.landlordUid == request.auth.uid && !request.resource.exists()));
    }
    
    // Wishlists collection
    match /wishlists/{uid} {
      allow read: if request.auth != null && isOwner(uid);
      allow write: if request.auth != null && isOwner(uid);
    }
    
    // Ratings collection
    match /ratings/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null && (isOwner(request.auth.uid) || isAdmin());
    }
    
    // Chats collection
    match /chats/{chatId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.landlordUid == request.auth.uid || resource.data.userUid == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.landlordUid == request.auth.uid || request.resource.data.userUid == request.auth.uid);
      allow update: if request.auth != null && (isAdmin() || request.resource.data.landlordUid == request.auth.uid || request.resource.data.userUid == request.auth.uid || resource.data.landlordUid == request.auth.uid || resource.data.userUid == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
      
      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && (isAdmin() || resource.data.landlordUid == request.auth.uid || resource.data.userUid == request.auth.uid);
        allow create: if request.auth != null && (isAdmin() || request.resource.data.senderUid == request.auth.uid);
        allow update: if request.auth != null && (isAdmin() || resource.data.senderUid == request.auth.uid);
        allow delete: if request.auth != null && (isAdmin() || resource.data.senderUid == request.auth.uid);
      }
    }
    
    // Notifications collection
    match /notifications/admin/{notificationId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null;
    }
    
    match /notifications/landlords/{uid}/{notificationId} {
      allow read: if request.auth != null && isOwner(uid);
      allow write: if request.auth != null;
    }
    
    match /notifications/users/{uid}/{notificationId} {
      allow read: if request.auth != null && isOwner(uid);
      allow write: if request.auth != null;
    }
  }
}
